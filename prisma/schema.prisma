generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  IT
  ENGLISH
}

enum Level {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique // always stored lowercase + trimmed
  name         String?
  passwordHash String // "scrypt$N$r$p$saltB64$hashB64"
  role         Role       @default(USER)
  sets         StudySet[]
  sessions     Session[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id // sha256(token) hex — the raw token is never stored
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model LoginAttempt { // DB-backed rate limiting (serverless, many instances)
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model StudySet {            // "Chương trình học"
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  category    Category
  level       Level?
  cards       Card[]
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

model Card {                // Câu hỏi / trả lời
  id          String   @id @default(uuid(7)) @db.Uuid
  setId       String   @db.Uuid
  set         StudySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question    String   // mặt trước (thuật ngữ / câu hỏi)
  answer      String   // mặt sau (định nghĩa / đáp án)
  explanation String?  // giải thích / ví dụ (tuỳ chọn)
  phonetic    String?  // phiên âm IPA (chỉ bộ ENGLISH)
  partOfSpeech String? // từ loại
  audioUrl    String?  // link audio phát âm
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([setId, position])
}
