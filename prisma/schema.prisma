generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryColor {
  BLUE
  GREEN
  AMBER
  PURPLE
  ROSE
  SLATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Level {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum Visibility {
  PRIVATE
  LINK    // ai có link xem được
  PUBLIC  // hiện ở thư viện khi approved
}

enum ReviewMode {
  FLASHCARD
  QUIZ
  TYPING
  MATCHING
  LISTEN
  CLOZE
  REVIEW
}

enum NotificationType {
  REVIEW_REMINDER
  SET_APPROVED
  SET_REJECTED
  SET_SUBSCRIBED
  SYSTEM
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique // always stored lowercase + trimmed
  name         String?    // tên hiển thị
  firebaseUid  String?    @unique // thông tin tham khảo; định danh thật là email
  fullName       String?
  birthYear      Int?
  nativeLanguage String?  // mã ISO 639-1
  onboardedAt    DateTime? // null = phải hoàn tất hồ sơ ở /welcome
  gender         Gender?
  avatarUrl      String?   // ảnh Google mới nhất (https)
  useGoogleAvatar Boolean  @default(true)
  role         Role       @default(USER)
  sets         StudySet[]
  categories   Category[]
  sessions     Session[]
  progress     StudyProgress[]
  dailyGoal      Int       @default(20) // số thẻ/ngày, 5–500
  pushReminders  Boolean   @default(false)
  lastReminderAt DateTime?
  subscriptions  SetSubscription[]
  cardReviews    CardReview[]
  studyDays      StudyDay[]
  aiUsage        AiUsage[]
  notifications  Notification[]
  pushSubscriptions PushSubscription[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id // sha256(token) hex — the raw token is never stored
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model LoginAttempt { // DB-backed rate limiting (serverless, many instances)
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Category {            // Danh mục do user tạo (mặc định: "IT", "Tiếng Anh")
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String        // 1–40 ký tự, trim; trùng tên (không phân biệt hoa/thường) kiểm bằng code
  color     CategoryColor @default(BLUE)
  isEnglish Boolean       @default(false) // true: bộ từ vựng tiếng Anh → phiên âm / tra từ điển / phát âm
  sets      StudySet[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model StudySet {            // "Chương trình học"
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  categoryId  String   @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level       Level?
  cards       Card[]
  progress    StudyProgress[]
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility  Visibility @default(PRIVATE)
  shareToken  String?    @unique // base64url ngẫu nhiên 22 ký tự, tạo khi bật LINK/PUBLIC
  approved    Boolean    @default(false) // admin duyệt mới hiện ở /library
  publishedAt DateTime?
  subscribers SetSubscription[]
  cardReviews CardReview[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([visibility, approved, publishedAt])
}

model Card {                // Câu hỏi / trả lời
  id          String   @id @default(uuid(7)) @db.Uuid
  setId       String   @db.Uuid
  set         StudySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question    String   // mặt trước (thuật ngữ / câu hỏi)
  answer      String   // mặt sau (định nghĩa / đáp án)
  explanation String?  // giải thích / ví dụ (tuỳ chọn)
  phonetic    String?  // phiên âm IPA (chỉ bộ ENGLISH)
  partOfSpeech String? // từ loại
  audioUrl    String?  // link audio phát âm
  position    Int      @default(0)
  reviews     CardReview[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([setId, position])
}

model StudyProgress {       // Tiến trình lật thẻ của 1 user trên 1 nhóm thẻ (1 dòng / user / set)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId       String    @db.Uuid
  set         StudySet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  known       String[]  // card ids đã thuộc (có thể chứa id thẻ đã xoá → lọc khi đọc)
  unknown     String[]  // card ids chưa thuộc
  order       String[]  // thứ tự thẻ của phiên hiện tại
  index       Int       @default(0)
  shuffle     Boolean   @default(false)
  swap        Boolean   @default(false)
  completedAt DateTime? // lần gần nhất học hết phiên
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([userId, setId])
  @@index([userId, updatedAt])
}

model SetSubscription {     // "Thêm vào thư viện của tôi" = tham chiếu, không sao chép
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String   @db.Uuid
  set       StudySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, setId])
  @@index([setId])
}

model CardReview {          // Trạng thái SRS + sao của 1 user trên 1 thẻ (chỉ tạo khi ôn/đánh sao)
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         String    @db.Uuid
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  setId          String    @db.Uuid
  set            StudySet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  ease           Float     @default(2.5)
  interval       Int       @default(0) // ngày
  reps           Int       @default(0)
  lapses         Int       @default(0)
  due            DateTime  @default(now())
  lastReviewedAt DateTime?
  starred        Boolean   @default(false)

  @@id([userId, cardId])
  @@index([userId, due])
  @@index([userId, setId])
}

model StudyDay {            // Tổng hợp theo ngày → thống kê, streak, mục tiêu
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  reviewed Int      @default(0)
  correct  Int      @default(0)
  newCards Int      @default(0)

  @@id([userId, day])
}

model AiUsage {
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
}

model JobRun {
  name      String   @id
  lastRunAt DateTime
  ok        Boolean
  result    Json?
}

/// Thông báo trong ứng dụng (chuông ở header); đồng thời được đẩy tới các thiết bị đã đăng ký.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String // đường dẫn tương đối trong app, vd "/review"
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

/// Một thiết bị/trình duyệt đã bật Web Push.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}
