# ── Local (Docker, mặc định) ─────────────────────────────────────────────
DATABASE_URL="postgresql://knowledge:knowledge@localhost:5433/knowledge"

# ── Supabase ─────────────────────────────────────────────────────────────
# Bỏ comment 2 dòng dưới (và comment DATABASE_URL local ở trên), thay [YOUR-PASSWORD].
# Mật khẩu có ký tự đặc biệt (@ : / # ? &) phải URL-encode.
#
# DATABASE_URL — app runtime: Transaction pooler (port 6543), IPv4.
# DATABASE_URL="postgresql://postgres.fhxkxfhmmwcaphrwyhqd:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
#
# DIRECT_URL — Prisma CLI (migrate/seed): Session pooler (port 5432), IPv4.
# DIRECT_URL="postgresql://postgres.fhxkxfhmmwcaphrwyhqd:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Direct connection (chỉ IPv6, dùng thay DIRECT_URL nếu mạng hỗ trợ IPv6):
# postgresql://postgres:[YOUR-PASSWORD]@db.fhxkxfhmmwcaphrwyhqd.supabase.co:5432/postgres?sslmode=require

# ── Đăng nhập (Google qua Firebase Auth — phương thức duy nhất) ──────────
# Tắt tạo tài khoản mới khi đăng nhập Google (mặc định bật):
# ALLOW_REGISTRATION="false"
#
# Chỉ cần khi chạy seed (npm run db:seed) — tài khoản admin (duy nhất) sở hữu 36 bộ học mẫu, được publish sẵn.
# Admin đăng nhập bằng Google với đúng email này; seed không đặt mật khẩu:
# ADMIN_EMAIL="trinhphuong.dev@gmail.com"   # admin duy nhất; giá trị khác bị seed từ chối
# ADMIN_NAME="Admin"

# Bí mật cho cron dọn dữ liệu (Vercel tự gửi "Authorization: Bearer $CRON_SECRET"). Tạo: openssl rand -hex 32
# CRON_SECRET=""

# ── Đợt 7–8: thông báo đẩy, AI, quota (đều tuỳ chọn) ─────────────────────
# Web Push (nhắc học, thông báo duyệt bộ thẻ…). Tạo cặp key: npm run push:keys
# Thiếu key → không gửi push (thông báo trong app vẫn được lưu).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"
#
# Gợi ý nghĩa/ví dụ bằng AI khi thêm từ. API key (Claude, ChatGPT, Gemini, Grok, DeepSeek, OpenAI-compatible)
# do admin quản lý ở /admin/ai/providers, lưu mã hoá trong DB bằng khoá dưới đây. Tạo: openssl rand -hex 32
# KHÔNG đổi giá trị sau khi đã lưu key (key cũ sẽ không giải mã được).
# AI_ENCRYPTION_KEY=""
# Dự phòng (cấu hình cũ): chỉ dùng khi admin CHƯA thêm nhà cung cấp nào.
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-haiku-4-5"
#
# Giới hạn dung lượng mỗi người dùng (ADMIN không bị giới hạn). Giá trị mặc định ở dưới:
# QUOTA_SETS_PER_USER=100
# QUOTA_CARDS_PER_USER=5000
# QUOTA_CARDS_PER_SET=2000
# QUOTA_SUBSCRIPTIONS_PER_USER=200
# Số lượt gợi ý AI mỗi người mỗi ngày:
# QUOTA_AI_PER_DAY=50

# URL gốc của site (link chia sẻ)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Firebase Auth (đăng nhập Google) ─────────────────────────────────────
# Lấy trong Firebase Console → Project settings → Your apps (Web app).
# Firebase chỉ dùng để xác minh danh tính; session vẫn do app quản lý (cookie kn_session).
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# Local: <project-id>.firebaseapp.com.
# PRODUCTION: đặt = domain của site (vd. knowledge.gutanembroidery.com). next.config.ts proxy /__/auth/* sang
# firebaseapp.com để đăng nhập chạy trên Safari/iOS PWA. Thêm domain này vào Firebase → Authentication →
# Settings → Authorized domains, và https://<domain>/__/auth/handler vào Authorized redirect URIs của OAuth client.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=knowledge-xxxx.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=knowledge-xxxx
# NEXT_PUBLIC_FIREBASE_APP_ID=...
